{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "crawl_run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenant_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "topic_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "posts_ref": {
      "type": "string",
      "minLength": 1
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "post_id": {
            "type": "string",
            "minLength": 1
          },
          "topic_query_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sentiment": {
            "type": "string",
            "enum": [
              "negative",
              "neutral",
              "positive"
            ]
          },
          "sentiment_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emotion": {
            "type": "string",
            "enum": [
              "anger",
              "anticipation",
              "disgust",
              "trust",
              "joy",
              "sadness",
              "surprise",
              "fear",
              "unknown"
            ]
          },
          "emotion_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "author_gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "unknown"
            ]
          },
          "author_gender_conf": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "author_age_range": {
            "type": "string",
            "enum": [
              "18_21",
              "22_30",
              "31_45",
              "46_55",
              "above_55",
              "unknown"
            ]
          },
          "author_age_conf": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "author_followers": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent_author_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "geo_region_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "thumb": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type",
                "url",
                "thumb"
              ],
              "additionalProperties": false
            }
          },
          "engagement": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "engagement_known": {
            "type": "boolean"
          }
        },
        "required": [
          "platform",
          "post_id",
          "topic_query_id",
          "sentiment",
          "sentiment_score",
          "emotion",
          "emotion_score",
          "author_gender",
          "author_gender_conf",
          "author_age_range",
          "author_age_conf",
          "author_followers",
          "model_version",
          "issues",
          "hashtags",
          "parent_author_id",
          "geo_region_code",
          "media",
          "engagement",
          "engagement_known"
        ],
        "additionalProperties": false
      }
    },
    "run_update": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "items_fetched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "items_matched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "items_new": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "new_high_watermark": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run_outcome": {
              "type": "string",
              "enum": [
                "succeeded",
                "partial",
                "failed"
              ]
            },
            "gap_window": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "since": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "until": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items_fetched",
            "items_matched",
            "items_new",
            "new_high_watermark",
            "run_outcome",
            "gap_window"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "batch_id",
    "crawl_run_id",
    "tenant_id",
    "topic_id",
    "posts_ref",
    "matches",
    "run_update"
  ],
  "additionalProperties": false,
  "title": "SinkAnalyticsPayload",
  "$id": "https://smip.local/contracts/sink-analytics-payload.v1.json"
}
