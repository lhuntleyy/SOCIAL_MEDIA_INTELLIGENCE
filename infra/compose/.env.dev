# Env dev untuk service Bun terhadap compose ini (tanpa secret produksi). Dipakai dev:up & test integrasi.
NODE_ENV=development
DATABASE_URL=postgres://smip_owner:smip_owner_dev@127.0.0.1:55432/smip
REDIS_URL=redis://127.0.0.1:56379
REDIS_CACHE_URL=redis://127.0.0.1:56380
CLICKHOUSE_URL=http://127.0.0.1:58123
CLICKHOUSE_DB=smip
CLICKHOUSE_USER=smip
CLICKHOUSE_PASSWORD=smip_dev
S3_ENDPOINT=http://127.0.0.1:57070
S3_ACCESS_KEY_ID=smip_dev
S3_SECRET_ACCESS_KEY=smip_dev_secret_123
S3_BUCKET_RAW=smip-raw
S3_BUCKET_EXPORTS=smip-exports
S3_BUCKET_TRAINING=smip-training
KMS_ADAPTER=vault-transit
KMS_KEY_ID=smip-kek
VAULT_ADDR=http://127.0.0.1:58200
VAULT_TOKEN=smip-dev
# I-22 collection stream (ADR-009) — aktif di dev untuk menguji dedup fetch
SCHEDULER_STREAMS_ENABLED=true
# HMAC fingerprint credential (dev saja — produksi dari secret manager). Sama untuk API & scripts/connectors.ts
CREDENTIAL_PEPPER_B64=CtU4diB+ftfL11zNPL5qpI+1tOIn9KHU8Ra2R2Y9fEc=
