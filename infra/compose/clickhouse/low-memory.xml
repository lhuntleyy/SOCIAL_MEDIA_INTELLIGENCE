<!-- Profil dev/demo VPS kecil (RAM ~2 GB): batas memori server, cache kecil, log sistem dimatikan.
     Rujukan: dokumentasi ClickHouse "Using ClickHouse with low memory". JANGAN dipakai untuk produksi. -->
<clickhouse>
    <max_server_memory_usage>524288000</max_server_memory_usage>          <!-- 500 MB batas keras seluruh server -->
    <mark_cache_size>33554432</mark_cache_size>                             <!-- 32 MB (default 5 GB) -->
    <index_mark_cache_size>0</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_uncompressed_cache_size>0</index_uncompressed_cache_size>
    <mmap_cache_size>64</mmap_cache_size>
    <compiled_expression_cache_size>8388608</compiled_expression_cache_size>
    <query_cache><max_size_in_bytes>0</max_size_in_bytes></query_cache>
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <!-- wajib ≤ background_pool_size × ratio (8) — ClickHouse menolak start bila tidak (sanity check) -->
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
    <!-- log sistem = memori + tulis disk terus-menerus; tidak dibutuhkan di dev -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <blob_storage_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
</clickhouse>
