{
  "uid": "smip-ingest",
  "title": "SMIP \u2014 Pengambilan & Provider",
  "tags": [
    "smip"
  ],
  "timezone": "Asia/Jakarta",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Jam sejak data berhasil terakhir (per platform)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_platform_last_success_age_seconds / 3600",
          "legendFormat": "{{platform}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run 1 jam terakhir per status",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "sum by (status) (smip_crawl_runs_recent)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Run gagal per platform (1 jam)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "sum by (platform) (smip_crawl_runs_recent{status=\"failed\"})",
          "legendFormat": "{{platform}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kedalaman antrean (backlog)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_queue_depth{state=\"backlog\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Skor kesehatan connector",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_provider_health_score",
          "legendFormat": "{{connector}} / {{account_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Circuit terbuka (2 = open)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "max by (connector) (smip_circuit_state)",
          "legendFormat": "{{connector}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Akun provider per status",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_provider_accounts",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Capability failed di routing aktif",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_capability_failed",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Outbox tertunda (detik)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_outbox_oldest_unpublished_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Plan aktif per platform",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_crawl_plans_active",
          "legendFormat": "{{platform}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Alert klien belum dibaca",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "smip_alert_events_open"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Cost guard throttle (1 jam)",
      "datasource": {
        "type": "prometheus",
        "uid": "smip-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smip-prom"
          },
          "expr": "increase(smip_cost_guard_throttled_total[1h])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "editable": true
}